{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "moduleDetection": "force",
    // Node runs these directly by stripping types, which requires the real extension.
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["src/**/*.test.ts", "src/lib/**/*.ts"]
}
